rules_version = '2';

// Mirrors firestore.rules' role/park model (same custom claims, same helper
// names) so the two rule sets stay easy to reason about together. See
// BRIDGE-CONTRACT.md for the storage path convention this enforces and the
// one open gap (voice notes have no uploader yet).
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function getParkId() {
      return request.auth.token.park_id;
    }

    function isUwaOfficial() {
      return isSignedIn() && getRole() == 'uwa_official';
    }

    function isWarden() {
      return isSignedIn() && getRole() == 'warden';
    }

    function isRanger() {
      return isSignedIn() && getRole() == 'ranger';
    }

    function belongsToPark(parkId) {
      return isSignedIn() && normalizeParkId(getParkId()) == normalizeParkId(parkId);
    }

    // Cross-service read of the corresponding Firestore document.
    // Only safe to call for read/update/delete, which only ever happen after
    // that document exists - see the create rule below for why create can't
    // depend on this.
    function docData(collection, docId) {
      return firestore.get(/databases/(default)/documents/$(collection)/$(docId)).data;
    }
    
    // Park identifiers arrive in three incompatible shapes (custom-claim kebab slug
    // "bwindi-impenetrable", mobile docs' enum name "BWINDI_IMPENETRABLE", portal docs'
    // kebab slug again) - same fix as firestore.rules' normalizeParkId: fold them all to
    // the slug so park scoping in these rules actually matches.
    function normalizeParkId(parkId) {
      if (parkId == null) return 'unknown';
      if (parkId is string) return parkId.lower().replace('_', '-').trim();
      return 'unknown';
    }

    function parkId(data) {
      return data.park_id != null
        ? normalizeParkId(data.park_id)
        : (data.park != null ? normalizeParkId(data.park) : 'unknown');
    }

    function reporterUid(data) {
      return data.reporter_uid != null ? data.reporter_uid : (data.userId != null ? data.userId : 'none');
    }

    function isDocReporter(collection, docId) {
      return isSignedIn() && request.auth.uid == reporterUid(docData(collection, docId));
    }

    function canReadMedia(collection, docId) {
      return isUwaOfficial() ||
        isDocReporter(collection, docId) ||
        ((isWarden() || isRanger()) && belongsToPark(parkId(docData(collection, docId))));
    }

    // Evidence photos and (once that feature lands) voice notes for a single
    // incident report. Path matches IncidentRemoteDataSourceImpl.kt exactly:
    // "{collection}/{docId}/{fileName}", flat, no per-user subfolder.
    match /{collection}/{docId}/{fileName} {
      allow create: if isSignedIn() && (collection in ['incidents', 'sos_alerts', 'sightings']) && (
        (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024) ||
        (request.resource.contentType.matches('audio/.*') && request.resource.size < 10 * 1024 * 1024)
      );

      allow read: if (collection in ['incidents', 'sos_alerts', 'sightings']) && canReadMedia(collection, docId);

      allow update, delete: if (collection in ['incidents', 'sos_alerts', 'sightings']) && (isDocReporter(collection, docId) || isUwaOfficial());
    }

    // Deny everything else - no implicit access to any other path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
